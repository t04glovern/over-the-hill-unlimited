<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The MelonLoader 0.7 build: the same source as the BepInEx build (../OverTheHillUnlimited), with MelonLoader's
        half of Plugin (Plugin.MelonLoader.cs) in place of BepInEx's. Builds Mods\OverTheHillUnlimited.MelonLoader.dll,
        the file name the community MelonLoader port used, so installing this one replaces it.
    -->
    <Import Project="..\OverTheHillUnlimited.props" />

    <PropertyGroup>
        <AssemblyName>OverTheHillUnlimited.MelonLoader</AssemblyName>
        <!-- The game folder with MelonLoader installed; the same as GameDir unless set in Config.Build.user.props -->
        <MelonLoaderGameDir Condition="'$(MelonLoaderGameDir)' == ''">$(GameDir)</MelonLoaderGameDir>
        <MelonLoaderDir>$(MelonLoaderGameDir)\MelonLoader\</MelonLoaderDir>
        <MelonLoaderLibDir>$(MelonLoaderDir)net6\</MelonLoaderLibDir>
        <MelonLoaderInteropDir>$(MelonLoaderDir)Il2CppAssemblies\</MelonLoaderInteropDir>
        <ModDeployDir>$(MelonLoaderGameDir)\Mods\</ModDeployDir>
        <SharedDir>..\OverTheHillUnlimited\</SharedDir>
    </PropertyGroup>

    <!-- Everything but BepInEx's half of Plugin -->
    <ItemGroup>
        <Compile Include="$(SharedDir)**\*.cs"
                 Exclude="$(SharedDir)obj\**;$(SharedDir)bin\**;$(SharedDir)Loader\BepInEx\**"
                 LinkBase="Shared" />
    </ItemGroup>

    <!-- MelonLoader's interop assemblies prefix the game's namespaces with Il2Cpp (the global namespace becomes Il2Cpp) -->
    <ItemGroup>
        <Using Include="Il2Cpp" />
        <Using Include="Il2CppFusion" />
        <Using Include="Il2CppFusion.Photon.Realtime" />
        <Using Include="Il2CppFunCore.Managers" />
        <Using Include="Il2CppFunCore.StateMachine.State" Alias="GameState" />
    </ItemGroup>

    <!-- Loader libraries: referenced straight from the installed MelonLoader so versions always match -->
    <ItemGroup>
        <Reference Include="$(MelonLoaderLibDir)MelonLoader.dll" Private="false" />
        <Reference Include="$(MelonLoaderLibDir)0Harmony.dll" Private="false" />
        <Reference Include="$(MelonLoaderLibDir)Il2CppInterop.Common.dll" Private="false" />
        <Reference Include="$(MelonLoaderLibDir)Il2CppInterop.Runtime.dll" Private="false" />
    </ItemGroup>

    <!-- Game proxies generated by MelonLoader on first launch -->
    <ItemGroup>
        <MelonInteropReferences Include="$(MelonLoaderInteropDir)*.dll" />
        <Reference Include="@(MelonInteropReferences)" Private="false" />
    </ItemGroup>

    <Target Name="CheckMelonLoaderInstalled" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(MelonLoaderLibDir)MelonLoader.dll')"
               Text="MelonLoader 0.7 not found in '$(MelonLoaderGameDir)'. Install it (see README) or set MelonLoaderGameDir in Config.Build.user.props." />
        <Error Condition="!Exists('$(MelonLoaderInteropDir)Assembly-CSharp.dll')"
               Text="Interop assemblies missing in '$(MelonLoaderInteropDir)'. Launch the game once with MelonLoader installed so it can generate them." />
    </Target>

    <!-- Copy the built mod into the game. Fails soft while the game is running (the DLL is locked). -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false'">
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModDeployDir)"
              ContinueOnError="WarnAndContinue" />
        <Message Importance="high" Text="Deployed $(TargetFileName) to $(ModDeployDir)" />
    </Target>

</Project>
