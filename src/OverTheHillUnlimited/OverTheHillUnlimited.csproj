<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- BepInEx 6 IL2CPP hosts plugins on its bundled .NET 6 runtime -->
        <TargetFramework>net6.0</TargetFramework>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>

        <AssemblyName>OverTheHillUnlimited</AssemblyName>
        <RootNamespace>OverTheHillUnlimited</RootNamespace>
        <Version>0.1.1</Version>

        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>portable</DebugType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Per-machine overrides (GameDir, DeployToGame). Copy Config.Build.user.props.template to create it. -->
    <Import Project="$(MSBuildThisFileDirectory)..\..\Config.Build.user.props"
            Condition="Exists('$(MSBuildThisFileDirectory)..\..\Config.Build.user.props')" />

    <PropertyGroup>
        <GameDir Condition="'$(GameDir)' == '' And '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
        <GameDir Condition="'$(GameDir)' == '' And '$(OS)' != 'Windows_NT'">$(HOME)/.local/share/Steam/steamapps/common/over the hill</GameDir>
        <BepInExDir>$(GameDir)\BepInEx\</BepInExDir>
        <BepInExCoreDir>$(BepInExDir)core\</BepInExCoreDir>
        <BepInExInteropDir>$(BepInExDir)interop\</BepInExInteropDir>
        <PluginDeployDir>$(BepInExDir)plugins\$(AssemblyName)\</PluginDeployDir>
    </PropertyGroup>

    <!-- Loader libraries: referenced straight from the installed BepInEx so versions always match -->
    <ItemGroup>
        <Reference Include="$(BepInExCoreDir)BepInEx.Core.dll" Private="false" />
        <Reference Include="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="false" />
        <Reference Include="$(BepInExCoreDir)BepInEx.Unity.Common.dll" Private="false" />
        <Reference Include="$(BepInExCoreDir)0Harmony.dll" Private="false" />
        <Reference Include="$(BepInExCoreDir)Il2CppInterop.Common.dll" Private="false" />
        <Reference Include="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
    </ItemGroup>

    <!-- Game proxies generated by BepInEx on first launch (Assembly-CSharp, Fusion.*, UnityEngine.*, Il2Cpp*) -->
    <ItemGroup>
        <InteropReferences Include="$(BepInExInteropDir)*.dll" />
        <Reference Include="@(InteropReferences)" Private="false" />
    </ItemGroup>

    <!-- Generates PluginVersion.Value from <Version> above, so the BepInPlugin version can't drift from it -->
    <Target Name="GeneratePluginVersion" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <PluginVersionFile>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(PluginVersionFile)"
                          Lines="// &lt;auto-generated/&gt; from the Version property in OverTheHillUnlimited.csproj;namespace OverTheHillUnlimited%3B;internal static class PluginVersion { public const string Value = &quot;$(Version)&quot;%3B }"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(PluginVersionFile)" />
            <FileWrites Include="$(PluginVersionFile)" />
        </ItemGroup>
    </Target>

    <Target Name="CheckBepInExInstalled" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll')"
               Text="BepInEx 6 IL2CPP not found in '$(GameDir)'. Install it (see README) or set GameDir in Config.Build.user.props." />
        <Error Condition="!Exists('$(BepInExInteropDir)Assembly-CSharp.dll')"
               Text="Interop assemblies missing in '$(BepInExInteropDir)'. Launch the game once with BepInEx installed so it can generate them." />
    </Target>

    <!-- Copy the built plugin into the game. Fails soft while the game is running (the DLL is locked). -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false'">
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(PluginDeployDir)"
              ContinueOnError="WarnAndContinue" />
        <Message Importance="high" Text="Deployed $(TargetFileName) to $(PluginDeployDir)" />
    </Target>

</Project>
